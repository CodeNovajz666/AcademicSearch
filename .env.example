# 复制本文件为 .env，放在项目根目录（Java 后端也可放 backend/ 目录下，均已被 .gitignore 忽略）
# 也可直接设置系统环境变量，效果相同。Java 与 Python 两个服务都从这里读取。

# ===================== 必填 =====================

# DashScope API Key：在阿里云百炼控制台 https://bailian.console.aliyun.com/ 获取
# 这是服务器默认 Key；单个账号可在应用左侧「设置」里填写自己的 Key 覆盖它
# 缺失时：Java 端向量化/问答接口报错；Python Agent 在未配置个人 Key时会话报错
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT 签名密钥（HS256，两个服务必须一致）：
# 生产环境必须替换为 64 位以上随机字符串；缺失或不足 32 字节时两个服务均拒绝启动
# 生成示例（PowerShell）：-join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | % {[char]$_})
JWT_SECRET=please-generate-a-long-random-secret-here

# MySQL 密码（无默认值，缺失时 Java 后端启动失败）
DB_PASSWORD=

# ===================== 可选 =====================

# MySQL 连接（默认 localhost:3306/example_db，用户 root）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=example_db
DB_USERNAME=root

# Milvus（milvus/docker-compose.yml 启动的 standalone 实例）
MILVUS_URI=http://localhost:19530
# embedding 维度：须与嵌入模型一致（text-embedding-v1/v2=1536），Java/Python 必须同值
MILVUS_EMBEDDING_DIM=1536

# 对话模型统一为 qwen3.8-flash（思考模型，走 DashScope OpenAI 兼容端点）。
# 协调者与专家子 Agent 的工具决策保留思考；流式收尾与技能自动关闭思考。
# Java 侧（经典 RAG / 知识抽取）的模型名在 backend/src/main/resources/application.yml 配置。
ORCHESTRATOR_MODEL=qwen3.8-flash
ORCHESTRATOR_MAX_STEPS=8
HISTORY_ROUNDS=6

# 专家子 Agent（检索/精读/分析）：独立模型与步数预算
SUBAGENT_MODEL=qwen3.8-flash
SUBAGENT_MAX_STEPS=4

# 翻译/总结技能所用模型
SKILL_MODEL=qwen3.8-flash
