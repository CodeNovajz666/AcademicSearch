# 复制本文件为 .env（或直接设置系统环境变量），.env 已被 .gitignore 忽略
# DashScope API Key（必填）：在阿里云百炼控制台 https://bailian.console.aliyun.com/ 获取
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# MySQL 连接（按需修改）
DB_USERNAME=root
DB_PASSWORD=123456

# JWT 签名密钥（生产环境必须修改为 64 位以上随机字符串）
JWT_SECRET=please-generate-a-long-random-secret-here
